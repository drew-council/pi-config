# direnv
.direnv

# authentication
agent/auth.json
agent/auth.pre-profiles.json
agent/auth-profiles.json
agent/auth-profiles/
secrets/*.json
secrets/work-drive/
# session logs
agent/sessions/
agent/plans/
agent/missions/
agent/browser-logs/
agent/transcriptions/

# Common local-only files.
.env
.env.*
*.log

# Python bytecode caches.
__pycache__/
*.py[cod]

# Bun dependency install directories.
bun/*
!bun/package.json
!bun/bun.lock
!bun/typecheck/
bun/typecheck/*
!bun/typecheck/package.json
agent/git/
# Generated from ./skills by scripts/sync-skills.ts.
agent/skills/
agent/node_modules/
agent/prompt-history.json
agent/remote-control.json
agent/prompt-history.json.*.tmp
agent/run-history.jsonl
agent/model-usage.jsonl
agent/local-settings.json
agent/models-store.json

/agent/pi-subagents/last-seen-version.json
/agent/mcp-auth.json
