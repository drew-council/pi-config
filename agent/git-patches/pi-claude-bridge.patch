@@ -19,6 +19,27 @@ function isDatedAlias(id: string): boolean {
 // sink below all known ones.
 const FAMILY_ORDER = ["fable", "opus", "sonnet", "haiku"];
 
+// Models Anthropic has shipped that the running pi-ai catalog may not list yet.
+// Each is synthesized from a base catalog entry only when the catalog lacks the
+// id, so an entry here becomes a no-op once pi-ai ships the model itself.
+// Applied to the raw catalog before buildModels (see MODELS in index.ts).
+const CATALOG_FALLBACKS: ReadonlyArray<{ id: string; name: string; basedOn: string }> = [
+	// Claude Opus 5.5 (2026-09-22): 1M context, 128K output, adaptive thinking
+	// always on — same shape as Opus 5 (platform.claude.com/docs/en/models/opus-5-5/overview).
+	{ id: "claude-opus-5-5", name: "Claude Opus 5.5", basedOn: "claude-opus-5" },
+];
+
+export function withCatalogFallbacks<T extends { id: string; [key: string]: any }>(piAiModels: T[]): T[] {
+	const out = [...piAiModels];
+	for (const fallback of CATALOG_FALLBACKS) {
+		if (out.some((m) => m.id === fallback.id)) continue;
+		const base = out.find((m) => m.id === fallback.basedOn);
+		if (!base) continue;
+		out.push({ ...base, id: fallback.id, name: fallback.name });
+	}
+	return out;
+}
+
 // Project pi-ai's model entries down to the fields pi's registerProvider expects,
 // newest generation first. Context-dependent display labels are applied after
 // plan/long-context config is known.
