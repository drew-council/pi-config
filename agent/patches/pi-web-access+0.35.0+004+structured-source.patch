diff --git a/node_modules/pi-web-access/structured-web-result.ts b/node_modules/pi-web-access/structured-web-result.ts
new file mode 100644
--- /dev/null
+++ b/node_modules/pi-web-access/structured-web-result.ts
@@ -0,0 +1,101 @@
+import { mkdtemp, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Type } from "typebox";
+
+// A small common envelope keeps heterogeneous retrieval modes script-readable.
+export const webOutputSchema = Type.Object({
+  resultId: Type.String(),
+  responseId: Type.Union([Type.String(), Type.Null()]),
+  status: Type.Union([Type.Literal("ok"), Type.Literal("partial"), Type.Literal("error")]),
+  mode: Type.String(),
+  content: Type.Array(Type.Union([
+    Type.Object({ type: Type.Literal("text"), text: Type.String() }),
+    Type.Object({ type: Type.Literal("image"), data: Type.String(), mimeType: Type.String() }),
+  ])),
+  sourceCount: Type.Integer({ minimum: 0 }),
+  sourcesTruncated: Type.Boolean(),
+  sources: Type.Array(Type.Object({ url: Type.String(), title: Type.String(), query: Type.Optional(Type.String()), snippet: Type.Optional(Type.String()), error: Type.Optional(Type.String()) })),
+  artifacts: Type.Array(Type.Object({ responseId: Type.Optional(Type.String()), path: Type.Optional(Type.String()), type: Type.String() })),
+  pagination: Type.Object({ offset: Type.Optional(Type.Number()), limit: Type.Optional(Type.Number()), returnedChars: Type.Optional(Type.Number()), contentLength: Type.Optional(Type.Number()), nextOffset: Type.Optional(Type.Union([Type.Number(), Type.Null()])), truncated: Type.Boolean() }),
+  errors: Type.Array(Type.String()),
+});
+
+export function redactWebText(text: string): string {
+  return text.replace(/\b(https?:\/\/)[^\s/@]+:[^\s/@]+@/gi, "$1[REDACTED]@")
+    .replace(/([?&](?:api[_-]?key|token|access_token|password|secret)=)[^&#\s]+/gi, "$1[REDACTED]")
+    .replace(/\b((?:Bearer|Basic)\s+)[\w.+/=-]+/gi, "$1[REDACTED]")
+    .replace(/\b((?:api[_-]?key|access_token|password|secret)\s*[:=]\s*)[^\s,;]+/gi, "$1[REDACTED]");
+}
+
+function redactWebDetails(value: any): any {
+  if (typeof value === "string") return redactWebText(value);
+  if (Array.isArray(value)) return value.map(redactWebDetails);
+  if (value && typeof value === "object") return Object.fromEntries(Object.entries(value).map(([key, item]) => [key, /^(?:authorization|cookie|api[_-]?key|access_token|password|secret)$/i.test(key) ? "[REDACTED]" : redactWebDetails(item)]));
+  return value;
+}
+
+export async function structuredWebResult(kind: string, callId: string, params: Record<string, unknown>, result: any, lookup: (id: string) => any, maxChars: number) {
+  const details = result.details ?? {};
+  const responseId = details.searchId ?? details.responseId ?? (kind === "get_search_content" ? params.responseId : null);
+  const stored = typeof responseId === "string" ? lookup(responseId) : null;
+  const artifacts: Array<{ responseId?: string; path?: string; type: string }> = [];
+  if (stored) artifacts.push({ responseId, type: stored.type });
+  if (typeof details.fetchId === "string") artifacts.push({ responseId: details.fetchId, type: "fetch" });
+  const errors: string[] = [];
+  if (details.error) errors.push(String(details.error));
+  const sources: Array<{ url: string; title: string; query?: string; snippet?: string; error?: string }> = [];
+  const add = (item: any, query?: string) => {
+    if (item.error || item.fetch_error) errors.push(String(item.error ?? item.fetch_error));
+    sources.push({ url: redactWebText(String(item.url ?? "")), title: redactWebText(String(item.title ?? "")).slice(0, 500), ...(query ? { query: redactWebText(query).slice(0, 500) } : {}), ...(item.snippet ? { snippet: redactWebText(String(item.snippet)).slice(0, 500) } : {}), ...(item.error || item.fetch_error ? { error: redactWebText(String(item.error ?? item.fetch_error)).slice(0, 500) } : {}) });
+  };
+  for (const query of stored?.queries ?? []) {
+    if (query.error) errors.push(String(query.error));
+    for (const item of query.results ?? []) add(item, query.query);
+  }
+  for (const item of details.sources ?? stored?.urls ?? []) add(item);
+  const artifact = stored?.artifact ?? details.artifact;
+  for (const item of artifact?.sources ?? []) add(item);
+  for (const error of artifact?.errors ?? []) errors.push(String(error.error));
+  if (!sources.length && Array.isArray(details.urls)) for (const url of details.urls) add({ url, title: details.title });
+  if (details.url && !sources.some(item => item.url === redactWebText(details.url))) add({ url: details.url, title: details.title });
+  let failed = !!result.isError || !!details.error || details.cancelled === true || details.successful === 0 || details.successfulQueries === 0 || (errors.length > 0 && sources.every(item => item.error));
+  if (failed && !errors.length) errors.push("No successful results");
+  const content: any[] = [];
+  // Reserve space for truncation guidance, independently of image payloads.
+  let remaining = Math.max(0, Math.min(maxChars, 50000) - 256);
+  let remainingLines = 1998;
+  let truncated = details.truncated === true;
+  const fullText = (result.content ?? []).filter((item: any) => item.type === "text").map((item: any) => redactWebText(item.text)).join("\n");
+  for (const item of result.content ?? []) {
+    if (item.type === "image") { content.push({ type: "image", data: item.data, mimeType: item.mimeType }); continue; }
+    if (item.type !== "text") continue;
+    const text = redactWebText(item.text);
+    const bytes = Buffer.from(text);
+    let bounded = bytes.subarray(0, remaining).toString("utf8").replace(/\uFFFD$/, "");
+    bounded = bounded.split("\n").slice(0, remainingLines).join("\n");
+    truncated ||= bounded.length < text.length;
+    remaining -= Buffer.byteLength(bounded);
+    remainingLines = Math.max(0, remainingLines - bounded.split("\n").length);
+    content.push({ type: "text", text: bounded });
+  }
+  if (fullText !== content.filter(item => item.type === "text").map(item => item.text).join("\n")) {
+    // Authenticated cache-off content must not acquire a new persistence path.
+    if (!params.auth) {
+      try {
+        const path = join(await mkdtemp(join(tmpdir(), "pi-web-output-")), "output.txt");
+        await writeFile(path, fullText, { mode: 0o600 });
+        artifacts.push({ path, type: "text" });
+        content.push({ type: "text", text: `\n[Output truncated; full text: ${path}]`.slice(0, 256) });
+      } catch {
+        failed = true;
+        errors.push("Full-output artifact could not be saved");
+        content.push({ type: "text", text: "\n[Output truncated; full-output artifact could not be saved.]" });
+      }
+    } else content.push({ type: "text", text: "\n[Output truncated; repeat authenticated fetch to read more.]" });
+  }
+  const pagination: any = { truncated };
+  for (const key of ["offset", "limit", "returnedChars", "contentLength", "nextOffset"]) if (typeof details[key] === "number" || (key === "nextOffset" && details[key] === null)) pagination[key] = details[key];
+  const structuredContent = { resultId: `${kind}:${callId}`, responseId: typeof responseId === "string" ? responseId : null, status: failed ? "error" : errors.length ? "partial" : "ok", mode: String(details.mode ?? params.mode ?? kind), content, sourceCount: sources.length, sourcesTruncated: sources.length > 100, sources: sources.slice(0, 100), artifacts, pagination, errors: [...new Set(errors.map(error => redactWebText(error).slice(0, 1000)))].slice(0, 100) };
+  return { ...result, details: redactWebDetails(result.details), content, isError: failed, structuredContent };
+}
