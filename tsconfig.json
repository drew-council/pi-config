{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["./bun/node_modules/@types"],
    "types": ["node", "bun"],
    // Package directories, not entry files: tsc then reads each package's types and bun its
    // runtime entry, so type checks and tests share this config.
    "paths": {
      "@earendil-works/pi-coding-agent": ["./bun/typecheck/node_modules/@earendil-works/pi-coding-agent"],
      "@earendil-works/pi-ai": ["./bun/typecheck/node_modules/@earendil-works/pi-ai"],
      "@earendil-works/pi-tui": ["./bun/typecheck/node_modules/@earendil-works/pi-tui"],
      "typebox": ["./bun/typecheck/node_modules/typebox"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": [".git", ".pi", "bun", "agent/git", "agent/sessions"]
}
